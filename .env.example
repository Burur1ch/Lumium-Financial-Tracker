# Database
DATABASE_URL=postgres://lumium:lumium@localhost:5432/lumium

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (optional unless billing is being tested)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PAYMENT_MODE=checkout
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=

# Support email (optional)
RESEND_API_KEY=
SUPPORT_EMAIL=support@lumium.app

# Receipt recognition (optional; receipt images are sent to Google Gemini when configured;
# local OCR remains the fallback)
GEMINI_API_KEY=
GEMINI_RECEIPT_MODEL=gemini-3.1-flash-lite
